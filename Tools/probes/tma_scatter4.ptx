// Hardware probe for 2D .tile::scatter4 TMA stores (EXT-TMA-SCATTER4).
.version 8.7
.target sm_100a
.address_size 64

// One .tile::scatter4 TMA store from an 8 KiB shared buffer (1024-aligned) at byte offset OFF;
// shared byte k holds (7 k + 3) % 251 + 1. Params: tensor map (by value), coords x, y0..y3, offset.
.visible .entry tmas4(
	.param .align 64 .b8 tmap[128], .param .u32 px, .param .u32 py, .param .u32 py1, .param .u32 py2,
	.param .u32 py3, .param .u32 poff)
{
	.reg .pred 	%p<4>;
	.reg .b32 	%r<30>;
	.reg .b64 	%rd<10>;
	.shared .align 1024 .b8 buf[8192];

	mov.u32 	%r1, %tid.x;
	mov.u32 	%r2, buf;
	// Thread i fills bytes 64 i .. 64 i + 63.
	mov.u32 	%r20, 0;
$L_FILL:
	shl.b32 	%r21, %r1, 6;
	add.u32 	%r21, %r21, %r20;
	mul.lo.u32 	%r22, %r21, 7;
	add.u32 	%r22, %r22, 3;
	rem.u32 	%r22, %r22, 251;
	add.u32 	%r22, %r22, 1;
	add.u32 	%r23, %r2, %r21;
	st.shared.u8 	[%r23], %r22;
	add.u32 	%r20, %r20, 1;
	setp.lt.u32 	%p2, %r20, 64;
	@%p2 bra 	$L_FILL;
	fence.proxy.async.shared::cta;
	bar.sync 	0;
	setp.ne.u32 	%p1, %r1, 0;
	@%p1 bra 	$L_DONE;
	ld.param.u32 	%r7, [px];
	ld.param.u32 	%r8, [py];
	ld.param.u32 	%r16, [py1];
	ld.param.u32 	%r17, [py2];
	ld.param.u32 	%r18, [py3];
	ld.param.u32 	%r9, [poff];
	add.u32 	%r11, %r2, %r9;
	mov.u64 	%rd1, tmap;
	cvta.param.u64 	%rd2, %rd1;
	cp.async.bulk.tensor.2d.global.shared::cta.tile::scatter4.bulk_group 	[%rd2, {%r7, %r8, %r16, %r17, %r18}], [%r11];
	cp.async.bulk.commit_group;
	cp.async.bulk.wait_group 0;
$L_DONE:
	ret;
}
