// Hardware probe for 2D tiled cp.reduce.async.bulk.tensor (EXT-TMA-REDUCE). REDOP is the
// reduction (add, min, max, inc, dec, and, or, xor); run with run_tma_reduce.
.version 8.7
.target sm_100a
.address_size 64

// One 2D tiled tensor reduction from an 8 KiB shared buffer (1024-aligned) at byte offset OFF;
// shared 32-bit word w holds (2654435761 w + 12345) mod 2^32. Params: tensor map (by value),
// coords x, y, offset.
.visible .entry tmared(
	.param .align 64 .b8 tmap[128], .param .u32 px, .param .u32 py, .param .u32 poff)
{
	.reg .pred 	%p<4>;
	.reg .b32 	%r<30>;
	.reg .b64 	%rd<10>;
	.shared .align 1024 .b8 buf[8192];

	mov.u32 	%r1, %tid.x;
	mov.u32 	%r2, buf;
	// Thread i fills words 16 i .. 16 i + 15.
	mov.u32 	%r20, 0;
$L_FILL:
	shl.b32 	%r21, %r1, 4;
	add.u32 	%r21, %r21, %r20;
	mul.lo.u32 	%r22, %r21, -1640531535;
	add.u32 	%r22, %r22, 12345;
	shl.b32 	%r23, %r21, 2;
	add.u32 	%r23, %r2, %r23;
	st.shared.u32 	[%r23], %r22;
	add.u32 	%r20, %r20, 1;
	setp.lt.u32 	%p2, %r20, 16;
	@%p2 bra 	$L_FILL;
	fence.proxy.async.shared::cta;
	bar.sync 	0;
	setp.ne.u32 	%p1, %r1, 0;
	@%p1 bra 	$L_DONE;
	ld.param.u32 	%r7, [px];
	ld.param.u32 	%r8, [py];
	ld.param.u32 	%r9, [poff];
	add.u32 	%r11, %r2, %r9;
	mov.u64 	%rd1, tmap;
	cvta.param.u64 	%rd2, %rd1;
	cp.reduce.async.bulk.tensor.2d.global.shared::cta.REDOP.tile.bulk_group 	[%rd2, {%r7, %r8}], [%r11];
	cp.async.bulk.commit_group;
	cp.async.bulk.wait_group 0;
$L_DONE:
	ret;
}
