// Hardware probe for tcgen05.mma.ws.cta_group::1.kind::i8 with A in Tensor Memory (EXT-TCFIG).
// IDESC is the instruction descriptor (N = 64).
.version 8.7
.target sm_100a
.address_size 64

// D (s32, Layout D, E or G) = A (128x32, s8, lane l holds row l) * B (32x64, s8).
// Params: A (4096 B, row-major by lane), B (4096 B canonical), D.
.visible .entry wsts(
	.param .u64 p0, .param .u64 p1, .param .u64 p3)
{
	.reg .pred 	%p<6>;
	.reg .b32 	%r<120>;
	.reg .b64 	%rd<20>;
	.shared .align 128 .b8 sA[4096];
	.shared .align 128 .b8 sB[4096];
	.shared .align 8 .b8 bar0[8];
	.shared .align 8 .b8 bar1[8];
	.shared .align 4 .b8 tslot[4];

	mov.u32 	%r1, %tid.x;
	shr.u32 	%r2, %r1, 5;
	mov.u32 	%r3, bar0;
	mov.u32 	%r4, bar1;
	mov.u32 	%r5, tslot;
	setp.ne.u32 	%p1, %r2, 0;
	setp.ne.u32 	%p2, %r1, 0;
	@%p1 bra 	$L_ALLOC;
	tcgen05.alloc.cta_group::1.sync.aligned.shared::cta.b32 	[%r5], 128;
$L_ALLOC:
	@%p2 bra 	$L_ISSUED;
	ld.param.u64 	%rd1, [p0];
	ld.param.u64 	%rd2, [p1];
	cvta.to.global.u64 	%rd3, %rd1;
	cvta.to.global.u64 	%rd4, %rd2;
	mov.u32 	%r6, sA;
	mov.u32 	%r7, sB;
	mbarrier.init.shared::cta.b64 	[%r3], 1;
	mbarrier.init.shared::cta.b64 	[%r4], 1;
	fence.proxy.async.shared::cta;
	mbarrier.arrive.expect_tx.shared::cta.b64 	_, [%r3], 8192;
	cp.async.bulk.shared::cta.global.mbarrier::complete_tx::bytes 	[%r6], [%rd3], 4096, [%r3];
	cp.async.bulk.shared::cta.global.mbarrier::complete_tx::bytes 	[%r7], [%rd4], 4096, [%r3];
$L_ISSUED:
	bar.sync 	0;
	ld.shared.u32 	%r8, [%r5];
	and.b32 	%r8, %r8, 65535;
	// Every thread stores its lane's 32 A bytes (p0 row-major by lane) at columns 64..71.
	ld.param.u64 	%rd15, [p0];
	cvta.to.global.u64 	%rd16, %rd15;
	mul.wide.u32 	%rd17, %r1, 32;
	add.s64 	%rd17, %rd16, %rd17;
	ld.global.v4.b32 	{%r16, %r17, %r18, %r19}, [%rd17];
	ld.global.v4.b32 	{%r20, %r21, %r22, %r23}, [%rd17+16];
	shl.b32 	%r37, %r2, 21;
	add.s32 	%r38, %r8, %r37;
	add.s32 	%r38, %r38, 64;
	tcgen05.st.sync.aligned.32x32b.x8.b32 	[%r38], {%r16, %r17, %r18, %r19, %r20, %r21, %r22, %r23};
	shl.b32 	%r14, %r2, 21;
	tcgen05.wait::st.sync.aligned;
	tcgen05.fence::before_thread_sync;
	bar.sync 	0;
	tcgen05.fence::after_thread_sync;
	@%p2 bra 	$L_COMMITTED;
$L_WAIT0:
	mbarrier.try_wait.parity.shared::cta.b64 	%p3, [%r3], 0;
	@!%p3 bra 	$L_WAIT0;
	mov.u32 	%r6, sA;
	mov.u32 	%r7, sB;
	shr.u32 	%r9, %r6, 4;
	add.u32 	%r10, %r9, 524288;
	mul.wide.u32 	%rd5, %r10, 1;
	add.u64 	%rd6, %rd5, 70437463654400;
	shr.u32 	%r11, %r7, 4;
	add.u32 	%r12, %r11, 524288;
	mul.wide.u32 	%rd7, %r12, 1;
	add.u64 	%rd8, %rd7, 70506183131136;
	mov.u32 	%r13, IDESC;
	mov.u32 	%r24, 0;
	add.s32 	%r39, %r8, 64;
	setp.ne.u32 	%p4, %r1, 0;
	tcgen05.mma.ws.cta_group::1.kind::i8 	[%r8], [%r39], %rd8, %r13, %p4;
	tcgen05.commit.cta_group::1.mbarrier::arrive::one.shared::cluster.b64 	[%r4];
$L_COMMITTED:
$L_WAIT1:
	mbarrier.try_wait.parity.shared::cta.b64 	%p5, [%r4], 0;
	@!%p5 bra 	$L_WAIT1;
	tcgen05.fence::after_thread_sync;
	add.s32 	%r15, %r8, %r14;
	tcgen05.ld.sync.aligned.32x32b.x32.b32 	{%r40, %r41, %r42, %r43, %r44, %r45, %r46, %r47, %r48, %r49, %r50, %r51, %r52, %r53, %r54, %r55, %r56, %r57, %r58, %r59, %r60, %r61, %r62, %r63, %r64, %r65, %r66, %r67, %r68, %r69, %r70, %r71}, [%r15];
	add.s32 	%r36, %r15, 32;
	tcgen05.ld.sync.aligned.32x32b.x32.b32 	{%r72, %r73, %r74, %r75, %r76, %r77, %r78, %r79, %r80, %r81, %r82, %r83, %r84, %r85, %r86, %r87, %r88, %r89, %r90, %r91, %r92, %r93, %r94, %r95, %r96, %r97, %r98, %r99, %r100, %r101, %r102, %r103}, [%r36];
	tcgen05.wait::ld.sync.aligned;
	ld.param.u64 	%rd12, [p3];
	cvta.to.global.u64 	%rd13, %rd12;
	mul.wide.u32 	%rd14, %r1, 256;
	add.s64 	%rd14, %rd13, %rd14;
	st.global.v4.b32 	[%rd14+0], {%r40, %r41, %r42, %r43};
	st.global.v4.b32 	[%rd14+16], {%r44, %r45, %r46, %r47};
	st.global.v4.b32 	[%rd14+32], {%r48, %r49, %r50, %r51};
	st.global.v4.b32 	[%rd14+48], {%r52, %r53, %r54, %r55};
	st.global.v4.b32 	[%rd14+64], {%r56, %r57, %r58, %r59};
	st.global.v4.b32 	[%rd14+80], {%r60, %r61, %r62, %r63};
	st.global.v4.b32 	[%rd14+96], {%r64, %r65, %r66, %r67};
	st.global.v4.b32 	[%rd14+112], {%r68, %r69, %r70, %r71};
	st.global.v4.b32 	[%rd14+128], {%r72, %r73, %r74, %r75};
	st.global.v4.b32 	[%rd14+144], {%r76, %r77, %r78, %r79};
	st.global.v4.b32 	[%rd14+160], {%r80, %r81, %r82, %r83};
	st.global.v4.b32 	[%rd14+176], {%r84, %r85, %r86, %r87};
	st.global.v4.b32 	[%rd14+192], {%r88, %r89, %r90, %r91};
	st.global.v4.b32 	[%rd14+208], {%r92, %r93, %r94, %r95};
	st.global.v4.b32 	[%rd14+224], {%r96, %r97, %r98, %r99};
	st.global.v4.b32 	[%rd14+240], {%r100, %r101, %r102, %r103};
	tcgen05.fence::before_thread_sync;
	bar.sync 	0;
	tcgen05.fence::after_thread_sync;
	@%p1 bra 	$L_DONE;
	tcgen05.dealloc.cta_group::1.sync.aligned.b32 	%r8, 128;
$L_DONE:
	ret;
}
