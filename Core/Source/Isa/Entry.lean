/-- The slots of an entry with their optional flags. -/
def Entry.slots (e : Entry) : List (Slot × Bool) :=
  e.slotSpecs.map fun s => (s.slot, s.optional)

/-- The operand specifications of an entry, in syntax order. -/
def Entry.operandSpecs (e : Entry) : List OpSpec :=
  e.operands.flatMap fun
    | .single s => [s]
    | .pipe ms => ms
    | .bracket ms => ms

