/-- The key of a segment from its UTF-8 bytes: ASCII codes as base-128 digits; `none`
for any other byte. -/
def segKey : List UInt8 → Nat → Option Nat
  | [], k => some k
  | b :: bs, k =>
    let n := b.toNat
    bif Nat.blt 0 n && Nat.blt n 128 then segKey bs (k * 128 + n) else none

/-- The token spelled by a dot-free string. The string is read through its UTF-8 bytes, which
the kernel reduces much faster than `String.toList`. -/
def Token.ofString? (s : String) : Option Token :=
  (segKey s.toByteArray.data.toList 0).bind Token.ofKey?

/-- The composite token of 2 segments, if any. -/
def Token.comp2? (a b : Token) : Option Token :=
  match a, b with
