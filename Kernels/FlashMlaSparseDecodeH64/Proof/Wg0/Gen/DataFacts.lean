/-- The facts of a class of sites from the block's reads. -/
def wFc (x : BitVec 64) : Site → Blk → List (Nat × Value)
  | s, b => match s with
    | .sink => f_set x b.sk
    | .bar0 => f_car x b.m b.l b.mx b.sk
    | .sld false 1 => f_sld1F x b.m b.l b.mx b.sk b.hi
    | .sld true 1 => f_sld1T x b.m b.l b.mx b.sk b.lo
    | .sldw | .tcfb | .vm => f_sldw x b.m b.l b.mx b.sk b.lo b.hi
    | .pst 0 => f_pst0 x b.m b.l b.mx b.sk b.lo b.hi b.mw
    | .pst 1 => f_pst1 x b.m b.l b.mx b.sk b.lo b.hi b.mw
    | .pst 2 => f_pst2 x b.m b.l b.mx b.sk b.lo b.hi b.mw
    | .pst 3 => f_pst3 x b.m b.l b.mx b.sk b.lo b.hi b.mw
    | .pst 4 => f_pst4 x b.m b.l b.mx b.sk b.lo b.hi b.mw
    | .pst 5 => f_pst5 x b.m b.l b.mx b.sk b.lo b.hi b.mw
    | .pst 6 => f_pst6 x b.m b.l b.mx b.sk b.lo b.hi b.mw
    | .pst 7 => f_pst7 x b.m b.l b.mx b.sk b.lo b.hi b.mw
    | .bar1 => f_pst7 x b.m b.l b.mx b.sk b.lo b.hi b.mw
    | .pld 0 => f_pld0 x b.m b.l b.mx b.sk b.lo b.hi b.mw
    | .pld 1 => f_pld1 x b.m b.l b.mx b.sk b.lo b.hi b.mw (b.pw 0)
    | .pld 2 => f_pld2 x b.m b.l b.mx b.sk b.lo b.hi b.mw (b.pw 0) (b.pw 1)
    | .pld 3 => f_pld3 x b.m b.l b.mx b.sk b.lo b.hi b.mw (b.pw 0) (b.pw 1) (b.pw 2)
    | .pld 4 => f_pld4 x b.m b.l b.mx b.sk b.lo b.hi b.mw (b.pw 0) (b.pw 1) (b.pw 2) (b.pw 3)
    | .pld 5 => f_pld5 x b.m b.l b.mx b.sk b.lo b.hi b.mw (b.pw 0) (b.pw 1) (b.pw 2) (b.pw 3)
        (b.pw 4)
    | .pld 6 => f_pld6 x b.m b.l b.mx b.sk b.lo b.hi b.mw (b.pw 0) (b.pw 1) (b.pw 2) (b.pw 3)
        (b.pw 4) (b.pw 5)
    | .pld 7 => f_pld7 x b.m b.l b.mx b.sk b.lo b.hi b.mw (b.pw 0) (b.pw 1) (b.pw 2) (b.pw 3)
        (b.pw 4) (b.pw 5) (b.pw 6)
    | .mst => f_mst x b.m b.l b.mx b.sk b.lo b.hi b.mw (b.pw 0) (b.pw 1) (b.pw 2) (b.pw 3) (b.pw 4)
        (b.pw 5) (b.pw 6) (b.pw 7)
    | .vote => f_vote x b.m b.l b.mx b.sk b.lo b.hi b.mw (b.pw 0) (b.pw 1) (b.pw 2) (b.pw 3)
        (b.pw 4) (b.pw 5) (b.pw 6) (b.pw 7) b.pm
    | .ost _ => f_ost x b.m b.l b.mx b.sk b.lo b.hi b.mw (b.pw 0) (b.pw 1) (b.pw 2) (b.pw 3)
        (b.pw 4) (b.pw 5) (b.pw 6) (b.pw 7) b.pm b.vt
    | .fpx => f_fin x b.m b.l b.mx b.sk b.lo b.hi b.mw (b.pw 0) (b.pw 1) (b.pw 2) (b.pw 3) (b.pw 4)
        (b.pw 5) (b.pw 6) (b.pw 7) b.pm b.vt
    | .rld _ => f_blk x b.m b.l b.mx b.sk b.lo b.hi b.mw (b.pw 0) (b.pw 1) (b.pw 2) (b.pw 3)
        (b.pw 4) (b.pw 5) (b.pw 6) (b.pw 7) b.pm b.vt
    | .rldw 0 => f_rldw0 x b.m b.l b.mx b.sk b.lo b.hi b.mw (b.pw 0) (b.pw 1) (b.pw 2) (b.pw 3)
        (b.pw 4) (b.pw 5) (b.pw 6) (b.pw 7) b.pm b.vt b.o
    | .rldw 1 => f_rldw1 x b.m b.l b.mx b.sk b.lo b.hi b.mw (b.pw 0) (b.pw 1) (b.pw 2) (b.pw 3)
        (b.pw 4) (b.pw 5) (b.pw 6) (b.pw 7) b.pm b.vt b.o
    | .rldw 2 => f_rldw2 x b.m b.l b.mx b.sk b.lo b.hi b.mw (b.pw 0) (b.pw 1) (b.pw 2) (b.pw 3)
        (b.pw 4) (b.pw 5) (b.pw 6) (b.pw 7) b.pm b.vt b.o
    | .rldw 3 => f_rldw3 x b.m b.l b.mx b.sk b.lo b.hi b.mw (b.pw 0) (b.pw 1) (b.pw 2) (b.pw 3)
        (b.pw 4) (b.pw 5) (b.pw 6) (b.pw 7) b.pm b.vt b.o
    | .rst 0 => f_rs0 x b.m b.l b.mx b.sk b.lo b.hi b.mw (b.pw 0) (b.pw 1) (b.pw 2) (b.pw 3)
        (b.pw 4) (b.pw 5) (b.pw 6) (b.pw 7) b.pm b.vt b.o
    | .rst 1 => f_rs1 x b.m b.l b.mx b.sk b.lo b.hi b.mw (b.pw 0) (b.pw 1) (b.pw 2) (b.pw 3)
        (b.pw 4) (b.pw 5) (b.pw 6) (b.pw 7) b.pm b.vt b.o
    | .rst 2 => f_rs2 x b.m b.l b.mx b.sk b.lo b.hi b.mw (b.pw 0) (b.pw 1) (b.pw 2) (b.pw 3)
        (b.pw 4) (b.pw 5) (b.pw 6) (b.pw 7) b.pm b.vt b.o
    | .rst 3 => f_rs3 x b.m b.l b.mx b.sk b.lo b.hi b.mw (b.pw 0) (b.pw 1) (b.pw 2) (b.pw 3)
        (b.pw 4) (b.pw 5) (b.pw 6) (b.pw 7) b.pm b.vt b.o
    | s' => wFe (lookupD (f_car x b.m b.l b.mx b.sk)) s' b

/-- The class of a site: the set-up sites share the scale, the loop head's sites the carried
statistics. -/
def wcls : Site → Site
  | .lenA | .lenB | .bwait | .arrL => .sink
  | .wv | .wq | .tcfa | .sld _ 0 => .bar0
  | .bar2 | .arrV | .mld => .mst
  | .ost _ => .ost 0
  | .rsf | .rsfb | .arrS => .fpx
  | .est | .ebar1 | .eld => .ebar0
  | .efa => .wsv
  | .ost2 c _ => .ost2 c 0
  | .old _ | .ofpx _ | .obar _ | .oel _ | .otma _ => .old 0
  | .rld _ => .rld 0
  | .rstw c => .rst c
  | s => s

/-- **The facts of a site** from the scale's bits and the block's reads. -/
def wF (x : BitVec 64) (s : Site) (b : Blk) : List (Nat × Value) := wFc x (wcls s) b

end
