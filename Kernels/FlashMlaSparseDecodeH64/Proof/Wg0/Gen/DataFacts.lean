    List (Nat × Value) :=
  (3565, joinValue ((lookupD (f_fin x m l mx sk lo hi mw p0 p1 p2 p3 p4 p5 p6 p7 pm vt)) 2951)
      (.bits 32 0)) ::
    (f_fin x m l mx sk lo hi mw p0 p1 p2 p3 p4 p5 p6 p7 pm vt)

def f_blk (x : BitVec 64) (m l mx sk : Value) (lo hi : List Value) (mw : Value)
    (p0 p1 p2 p3 p4 p5 p6 p7 : Value × Value) (pm : Value) (vt : Bool) :
    List (Nat × Value) :=
  Gen.alpha_facts1 (lookupD (f_a0 x m l mx sk lo hi mw p0 p1 p2 p3 p4 p5 p6 p7 pm vt)) ++
    (f_fin x m l mx sk lo hi mw p0 p1 p2 p3 p4 p5 p6 p7 pm vt)

def f_rldw0 (x : BitVec 64) (m l mx sk : Value) (lo hi : List Value) (mw : Value)
    (p0 p1 p2 p3 p4 p5 p6 p7 : Value × Value) (pm : Value) (vt : Bool) (o : List Value) :
    List (Nat × Value) :=
  (f_blk x m l mx sk lo hi mw p0 p1 p2 p3 p4 p5 p6 p7 pm vt) ++
    factsFrom (oRegs 0) (lookupD ((oRegs 0).zip o))

