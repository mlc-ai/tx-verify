@[expose] public section

/-! # The lemmas of the probabilities

`Gen.pw` (pcs 586-703): with the maximum `m'` (`%r2492`), the factor `alpha` (`%r2951`), the scale
`sc` and the sums `S c` (extended reals, `-inf` for a masked column), column `c` has the
probability `w0Prob sc m' (S c)` (the exponential of the fma, exact), the sixteen words stored by
the `ost` sites are the bf16 packs of the pairs, and the running sum is
`l * alpha + sum_c w0Prob sc m' (S c)`. Generated by `Gen/w0num_p_gen.py`. -/

namespace PTX.Kernels.FlashMlaSparseDecodeH64.Proof.Wg0.Data
open PTX PTX.Flow PTX.Proof PTX.Assumption PTX.Kernels.FlashMlaSparseDecodeH64.Proof.Wg0.Gen
  PTX.Kernels.FlashMlaSparseDecodeH64.Proof.Wg0

noncomputable section

set_option linter.unusedSimpArgs false

/-- The running sum of the first `n` terms. -/
def w0Se (f : Nat → ℝ) : Nat → ℝ
  | 0 => 0
  | n + 1 => w0Se f n + f n

/-- The probabilities of the even and the odd columns. -/
def w0Pe (sc m : ℝ) (S : Nat → EReal) (i : Nat) : ℝ := w0Prob sc m (S (2 * i))
def w0Po (sc m : ℝ) (S : Nat → EReal) (i : Nat) : ℝ := w0Prob sc m (S (2 * i + 1))

theorem w0Se_sum32 (sc m : ℝ) (S : Nat → EReal) :
    w0Se (w0Pe sc m S) 16 + w0Se (w0Po sc m S) 16 =
      ∑ i ∈ Finset.range 32, w0Prob sc m (S i) := by
  simp only [w0Se, w0Pe, w0Po, Finset.sum_range_succ, Finset.sum_range_zero]
  ring

theorem pairRead_zero :
    pairRead (.bits 64 0) = some (.ok (((0 : ℝ) : EReal), ((0 : ℝ) : EReal))) := by
  have h := readEReal_of_valFloat valFloat_zero
  exact pairRead_of_reads (by simpa [splitValue, truncBits] using h)
    (by simpa [splitValue, truncBits] using h)

theorem w0p_ex2 {s : EReal} (hs : SK.ni.Lane s) {sc m : ℝ} (hsc : 0 < sc) :
    okVal (.bits 32 0) (ex2E true (erealValue .f32 (s * (sc : EReal) + ((-m : ℝ) : EReal)))) =
      .float .f32 (w0Prob sc m s) := by
  rcases hs with ⟨r, rfl⟩ | rfl
  · rw [← EReal.coe_mul, ← EReal.coe_add, erealValue_coe, ex2E_real (readEReal_float _)]
    simp only [w0Prob, okVal, EReal.coe_ne_bot, ite_false, EReal.toReal_coe]
    rw [mul_comm, sub_eq_add_neg]; rfl
  · have : (⊥ : EReal) * (sc : EReal) + ((-m : ℝ) : EReal) = ⊥ := by
      rw [EReal.bot_mul_of_pos (by exact_mod_cast hsc), EReal.bot_add]
    rw [this, erealValue_bot, ex2E_negInf]
    simp [w0Prob, okVal]

theorem w0p_fma {va vb vc : Value} {s0 s1 : EReal} {sc m : ℝ} (hsc : 0 < sc)
    (ha : pairRead va = some (.ok (s0, s1))) (l0 : SK.ni.Lane s0) (l1 : SK.ni.Lane s1)
    (hb : pairRead vb = some (.ok ((sc : EReal), (sc : EReal))))
    (hc : pairRead vc = some (.ok (((-m : ℝ) : EReal), ((-m : ℝ) : EReal)))) :
    okVal (.bits 64 0) (fma2E va vb vc) =
      .pair (erealValue .f32 (s0 * (sc : EReal) + ((-m : ℝ) : EReal)))
        (erealValue .f32 (s1 * (sc : EReal) + ((-m : ℝ) : EReal))) := by
  obtain ⟨z0, k0⟩ := w0r_mulpos l0 hsc
  obtain ⟨z1, k1⟩ := w0r_mulpos l1 hsc
  rw [fma2E_reads ha hb hc (by rw [z0]; exact (lane_add_coe k0 (-m)).2)
    (by rw [z1]; exact (lane_add_coe k1 (-m)).2)]
  rfl

theorem w0p_add {r1 r2 : Nat} (hne : r1 ≠ r2) {va vb : Value} {a b p q : ℝ}
    (ha : pairRead va = some (.ok ((a : EReal), (b : EReal))))
    (hb : vb = .pair (.float .f32 p) (.float .f32 q)) :
    okVal (.bits 32 0) (fF add2NL [.reg r1, .reg r2] [va, vb]) =
      .pair (.float .f32 (a + p)) (.float .f32 (b + q)) := by
  have e : fF add2NL [.reg r1, .reg r2] [va, vb] = add2NE va vb := by
    have h21 : (r2 == r1) = false := beq_false_of_ne (Ne.symm hne)
    simp [fF, fOpnd, lk, regsOf, regOf, add2NL, List.lookup, h21]
  rw [e, add2NE_reads ha (hb ▸ pairRead_pair (rd_float p) (rd_float q))
    (addEReal_coe a p) (addEReal_coe b q)]
  simp only [erealValue_coe]
  rfl

theorem w0p_bf {x y : ℝ} :
    okVal (.bits 32 0) (bfE [.float .f32 x, .float .f32 y]) = Assumptions.bf16Pair y x := by
  simp [bfE, valFloat, okVal, pure, Except.pure, Except.toOption]

/-- The negated maximum, twice: the pair the fmas add. -/
theorem w0p_neg {Vm : Value} {m : ℝ} (h : Rd Vm (m : EReal)) :
    okVal (.bits 32 0) (fF (negL true) [.reg 2950] [Vm]) = .float .f32 (-m) := by
  have e : fF (negL true) [.reg 2950] [Vm] = negE true Vm := by
    simp [fF, fOpnd, lk, regsOf, regOf, negL, List.lookup]
  rw [e, negE_reads (rd_read h), ← EReal.coe_neg, erealValue_coe]
  rfl


end
end PTX.Kernels.FlashMlaSparseDecodeH64.Proof.Wg0.Data
