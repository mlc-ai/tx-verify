module

public import Kernels.FlashMlaSparseDecodeH64.Proof.Wg0.Data.NumChain

@[expose] public section

/-! # The later links of the chain

The registers of the masked words, the scale and the statistics keep the values of the first
links along the chain (`w0c_toS<k>`: at the facts of peer load `k` they are those of the mask
chain), and the sums of peer stage `k` keep theirs to the last peer load (`w0c_up<k>`). Generated by
`Gen/w0num_chain_gen.py`. -/

namespace PTX.Kernels.FlashMlaSparseDecodeH64.Proof.Wg0.Data
open PTX PTX.Flow PTX.Proof PTX.Kernels.FlashMlaSparseDecodeH64.Proof.Wg0.Gen

noncomputable section

variable {x : BitVec 64} {m l mx sk : Value} {lo hi : List Value} {mw : Value}
  {p0 p1 p2 p3 p4 p5 p6 p7 : Value × Value} {pm : Value} {vt : Bool}

theorem w0c_sc_s7 : ∀ r ∈ w0KeepSc,
    lookupD (s_pld7 x m l mx sk lo hi mw p0 p1 p2 p3 p4 p5 p6 p7) r =
      lookupD (s_vm x m l mx sk lo hi mw) r := by
  intro r hr
  have h : ∀ r ∈ w0KeepSc, r ∈ w0KeepW7 := by decide
  rw [w0c_toS7 r (h r hr), w0c_sc_mvm r hr]

theorem w0c_sc_p8 : ∀ r ∈ w0KeepSc,
    lookupD (f_pld8 x m l mx sk lo hi mw p0 p1 p2 p3 p4 p5 p6 p7) r =
      lookupD (s_vm x m l mx sk lo hi mw) r := by
  intro r hr
  have h : ∀ r ∈ w0KeepSc, r ∈ w0KeepPld8 := by decide
  rw [w0c_fr_pld8 r (h r hr), w0c_sc_s7 r hr]

theorem w0c_sc_mst : ∀ r ∈ w0KeepSc,
    lookupD (f_mst x m l mx sk lo hi mw p0 p1 p2 p3 p4 p5 p6 p7) r =
      lookupD (s_vm x m l mx sk lo hi mw) r := by
  intro r hr
  have h : ∀ r ∈ w0KeepSc, r ∈ w0KeepMst := by decide
  rw [w0c_fr_mst r (h r hr), w0c_sc_p8 r hr]

theorem w0c_sn_mld (r : Nat) (h : r ≠ 1110) :
    lookupD (s_mld x m l mx sk lo hi mw p0 p1 p2 p3 p4 p5 p6 p7 pm) r =
      lookupD (f_mst x m l mx sk lo hi mw p0 p1 p2 p3 p4 p5 p6 p7) r := by
  unfold s_mld
  exact lk_snoc (by simp only [List.zip_cons_cons, List.zip_nil_left, List.map_cons, List.map_nil,
    List.mem_cons, List.not_mem_nil, or_false]; omega)

theorem w0c_hd_mld : lookupD (s_mld x m l mx sk lo hi mw p0 p1 p2 p3 p4 p5 p6 p7 pm) 1110 = pm := by
  unfold s_mld
  refine lk_snoc_head ?_ (by simp)
  unfold f_mst
  simp only [rmax_facts2, factsFrom, List.map_append, List.map_cons, List.map_nil]
  decide

theorem w0c_sc_mld : ∀ r ∈ w0KeepSc,
    lookupD (s_mld x m l mx sk lo hi mw p0 p1 p2 p3 p4 p5 p6 p7 pm) r =
      lookupD (s_vm x m l mx sk lo hi mw) r := by
  intro r hr
  have h : ∀ r ∈ w0KeepSc, r ≠ 1110 := by decide
  rw [w0c_sn_mld r (h r hr), w0c_sc_mst r hr]

theorem w0c_sc_vote : ∀ r ∈ [467, 3243, 2950, 2955, 2880],
    lookupD (f_vote x m l mx sk lo hi mw p0 p1 p2 p3 p4 p5 p6 p7 pm) r =
      lookupD (s_vm x m l mx sk lo hi mw) r := by
  intro r hr
  have h : ∀ r ∈ [467, 3243, 2950, 2955, 2880], r ∈ w0KeepVote := by decide
  have h2 : ∀ r ∈ [467, 3243, 2950, 2955, 2880], r ∈ w0KeepSc := by decide
  rw [w0c_fr_vote r (h r hr), w0c_sc_mld r (h2 r hr)]

theorem w0c_sc_vh : ∀ r ∈ [467, 3243, 2950, 2955, 2880],
    lookupD (f_vh x m l mx sk lo hi mw p0 p1 p2 p3 p4 p5 p6 p7 pm) r =
      lookupD (s_vm x m l mx sk lo hi mw) r := by
  intro r hr
  have h : ∀ r ∈ [467, 3243, 2950, 2955, 2880], r ∈ w0KeepVh := by decide
  rw [w0c_fr_vh r (h r hr), w0c_sc_vote r hr]

theorem w0c_sc_join : ∀ r ∈ [467, 3243, 2955],
    lookupD (f_join x m l mx sk lo hi mw p0 p1 p2 p3 p4 p5 p6 p7 pm vt) r =
      lookupD (s_vm x m l mx sk lo hi mw) r := by
  intro r hr
  have h : ∀ r ∈ [467, 3243, 2955], r ∈ w0KeepJoin := by decide
  rw [w0c_fr_join r (h r hr), w0c_sc_vh r (by revert hr; revert r; decide)]

def w0KeepSums : List Nat :=
  [3242, 3247, 3252, 3256, 3260, 3264, 3268, 3272, 3276, 3280, 3284, 3288, 3292, 3296,
   3300, 3304, 2880]

theorem w0c_su_mst : ∀ r ∈ w0KeepSums,
    lookupD (f_mst x m l mx sk lo hi mw p0 p1 p2 p3 p4 p5 p6 p7) r =
      lookupD (f_pld8 x m l mx sk lo hi mw p0 p1 p2 p3 p4 p5 p6 p7) r := by
  intro r hr
  have h : ∀ r ∈ w0KeepSums, r ∈ w0KeepMst := by decide
  rw [w0c_fr_mst r (h r hr)]

theorem w0c_su_join : ∀ r ∈ w0KeepSums,
    lookupD (f_join x m l mx sk lo hi mw p0 p1 p2 p3 p4 p5 p6 p7 pm vt) r =
      lookupD (f_pld8 x m l mx sk lo hi mw p0 p1 p2 p3 p4 p5 p6 p7) r := by
  intro r hr
  have h1 : ∀ r ∈ w0KeepSums, r ∈ w0KeepJoin := by decide
  have h2 : ∀ r ∈ w0KeepSums, r ∈ w0KeepVh := by decide
  have h3 : ∀ r ∈ w0KeepSums, r ∈ w0KeepVote := by decide
  have h4 : ∀ r ∈ w0KeepSums, r ≠ 1110 := by decide
  rw [w0c_fr_join r (h1 r hr), w0c_fr_vh r (h2 r hr), w0c_fr_vote r (h3 r hr),
    w0c_sn_mld r (h4 r hr), w0c_su_mst r hr]

end
end PTX.Kernels.FlashMlaSparseDecodeH64.Proof.Wg0.Data
