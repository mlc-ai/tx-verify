/-- The register of sum pair `j`. -/
def w0SumReg (j : Nat) : Nat :=
  [3242, 3247, 3252, 3256, 3260, 3264, 3268, 3272, 3276, 3280, 3284, 3288, 3292, 3296, 3300,
    3304].getD j 0

/-- The fold of `max` over `n` columns from column `a`, from `-inf`. -/
def w0Fold (S : Nat → EReal) (a : Nat) : Nat → EReal
  | 0 => ⊥
  | n + 1 => max (w0Fold S a n) (S (a + n))

theorem w0Fold_add (S : Nat → EReal) (a p : Nat) :
    w0Fold S 0 (a + p) = max (w0Fold S 0 a) (w0Fold S a p) := by
  induction p with
  | zero => simp [w0Fold]
  | succ p ih =>
    show max (w0Fold S 0 (a + p)) (S (0 + (a + p))) =
      max (w0Fold S 0 a) (max (w0Fold S a p) (S (a + p)))
    rw [ih, max_assoc]; simp

theorem w0Fold_sup (S : Nat → EReal) (n : Nat) : w0Fold S 0 n = (Finset.range n).sup S := by
  induction n with
  | zero => simp [w0Fold]
  | succ n ih => rw [Finset.range_add_one, Finset.sup_insert, ← ih]; simp [w0Fold, max_comm]

theorem w0r_max {r1 r2 : Nat} (hne : r1 ≠ r2) {va vb : Value} {x y : EReal} (ha : Rd va x)
    (hb : Rd vb y) :
    Rd (okVal (.bits 32 0) (fF maxFL [.reg r1, .reg r2] [va, vb])) (max x y) := by
  have e : fF maxFL [.reg r1, .reg r2] [va, vb] = maxFE va vb := by
    have h21 : (r2 == r1) = false := beq_false_of_ne (Ne.symm hne)
    simp [fF, fOpnd, lk, regsOf, regOf, maxFL, List.lookup, h21]
  rw [e, maxFE_reads (rd_read ha) (rd_read hb)]
  exact rd_erealValue (SK.lane_max (k := .ni) (.inr rfl) (rd_lane ha) (rd_lane hb))

theorem w0r_maxI {r : Nat} {va : Value} {x : EReal} (ha : Rd va x) :
    Rd (okVal (.bits 32 0) (fF maxFL [.reg r, .f32imm 4286578688] [va])) (max ⊥ x) := by
  have e : fF maxFL [.reg r, .f32imm 4286578688] [va] = maxFE va negInf32 := by
    simp [fF, fOpnd, lk, regsOf, regOf, maxFL, List.lookup]
  rw [e, maxFE_reads (rd_read ha) readEReal_negInf, max_comm]
  exact rd_erealValue (SK.lane_max (k := .ni) (.inr rfl) (.inr rfl) (rd_lane ha))

/-- Multiplying a lane by a positive real: no declined case, and a lane again. -/
theorem w0r_mulpos {M : EReal} (hm : SK.ni.Lane M) {sc : ℝ} (hsc : 0 < sc) :
    mulEReal M (sc : EReal) = some (M * (sc : EReal)) ∧ SK.ni.Lane (M * (sc : EReal)) := by
  rcases hm with ⟨r, rfl⟩ | rfl
  · exact ⟨by rw [mulEReal_coe]; rfl, .inl ⟨r * sc, by push_cast; rfl⟩⟩
  · refine ⟨?_, .inr (EReal.bot_mul_of_pos (by exact_mod_cast hsc))⟩
    unfold mulEReal
    rw [ite_eq_right_iff.mpr (fun h => absurd h (by simp [EReal.coe_eq_zero, hsc.ne']))]

theorem w0r_scale_has {a b : Nat} (hne : a ≠ b) {vm vs : Value} {M : EReal} {sc : ℝ}
    (hsc : 0 < sc) (hm : Rd vm M) (hs : readEReal .f32 vs = some (.ok (sc : EReal))) :
    Rd (okVal (.bits 32 0) (fF (mulL true) [.reg a, .reg b] [vm, vs])) (M * (sc : EReal)) ∧
      SK.ni.Has (okVal (.bits 32 0) (fF (mulL true) [.reg a, .reg b] [vm, vs])) := by
  have e : fF (mulL true) [.reg a, .reg b] [vm, vs] = mulE true vm vs := by
    have h21 : (b == a) = false := beq_false_of_ne (Ne.symm hne)
    simp [fF, fOpnd, lk, regsOf, regOf, mulL, List.lookup, h21]
  obtain ⟨hz, hl⟩ := w0r_mulpos hm.2.2 hsc
  rw [e, mulE_reads (rd_read hm) hs hz]
  exact ⟨rd_erealValue hl, SK.has_erealValue hl⟩

theorem w0r_scale {a b : Nat} (hne : a ≠ b) {vm vs : Value} {M : EReal} {sc : ℝ} (hsc : 0 < sc)
    (hm : Rd vm M) (hs : readEReal .f32 vs = some (.ok (sc : EReal))) :
    Rd (okVal (.bits 32 0) (fF (mulL true) [.reg a, .reg b] [vm, vs])) (M * (sc : EReal)) :=
  (w0r_scale_has hne hsc hm hs).1

