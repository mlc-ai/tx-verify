/-- A control register: not a data register. -/
def ctl (r : Nat) : Bool := !dataRanges.any fun (a, b) => Nat.ble a r && Nat.ble r b

/-- The control registers live at program counter `pc`: the generated liveness without the data
registers. -/
noncomputable def ctlLive (pc : Nat) : List Nat := (PTX.Kernels.TmlFa4Fwd.Flow.live pc).filter ctl

