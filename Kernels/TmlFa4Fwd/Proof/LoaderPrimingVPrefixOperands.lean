@[expose] public section

namespace PTX.Kernels.TmlFa4Fwd.Loader
open PTX PTX.Proof PTX.Flow Prologue Epilogue

noncomputable section

/-- A V pair uses the saved row of the corresponding eight-pair packet half. -/
def primingVPairBases (p : Params) (batch head tile warp : Nat)
    (pair : Fin 16) (lane : Nat) : Nat :=
  primingVRowPointer p batch head (primingLaneRow tile (32 * warp + lane) + 64 * (pair.val / 8))

private theorem vPacketCutLater {l : Launch} {X : Execution} {g index rank : Nat}
    {s : TState} {ending : Option TState} {F : List (Nat × Value)}
    (slot : Fin 2) (pair : Fin 16) (hPair : 0 < pair.val) (hSlot : vPacketSlot pair = slot)
    (hEntry : At s (if slot.val = 0 then 809 else 855) F)
    (hFrame : ∀ branch, ((kernel.code.drop (if slot.val = 0 then 809 else 855)).take
      (vPacketShufflePc pair - (if slot.val = 0 then 809 else 855))).all
        (fun ins => loaderPipelineCutOp (if slot.val = 0 then 809 else 855)
          (vPacketShufflePc pair) branch (F.map Prod.fst) ins.op) = true)
    (hr : Run kernel Assumptions.all l g s ((X.tr g).drop index) ending)
    (hRank : ((X.tr g).take index).countP Execution.isShfl =
      rank + (if slot.val = 0 then 2 else 16))
    {j : Nat} {target : Event} (he : X.get (g, j) = some target) (hBefore : index ≤ j)
    (hLater : vPacketShufflePc pair ≤ target.pc ∨ (Execution.isShfl target = true ∧
      rank + 2 * pair.val ≤ ((X.tr g).take j).countP Execution.isShfl))
    (hSafe : ∀ f, target.kind ≠ .ub f) :
    ∃ t pos stop, pos ≤ j ∧ At t (vPacketShufflePc pair) F ∧
      Run kernel Assumptions.all l g t ((X.tr g).drop pos) stop ∧
      ((X.tr g).take pos).countP Execution.isShfl = rank + 2 * pair.val := by
  let start := if slot.val = 0 then 809 else 855
  let cut := vPacketShufflePc pair
  let prior := if slot.val = 0 then 2 else 16
  have hCount : prior + loaderShuffleTail cut start = 2 * pair.val := by
    subst slot
    fin_cases pair <;> first | exact (Nat.lt_irrefl 0 hPair).elim |
      (set_option maxRecDepth 100000 in kernel_rfl)
  have hRange : 174 ≤ start ∧ start ≤ cut ∧ cut ≤ 1901 := by
    subst slot
    fin_cases pair <;> first | exact (Nat.lt_irrefl 0 hPair).elim | decide
  have hCode : ((kernel.code.drop start).take (cut - start)).all LoaderCountedInstr = true := by
    subst slot
    fin_cases pair <;> first | exact (Nat.lt_irrefl 0 hPair).elim |
      (set_option maxRecDepth 100000 in kernel_rfl)
  have hReach : cut ≤ target.pc ∨ (Execution.isShfl target = true ∧
      ((X.tr g).take index).countP Execution.isShfl + loaderShuffleTail cut start ≤
      ((X.tr g).take j).countP Execution.isShfl) := by
    rw [hRank]
    change _ ∨ (_ ∧ rank + prior + _ ≤ _)
    rw [Nat.add_assoc, hCount]
    exact hLater
  obtain ⟨t, front, stop, _, ht, hRun, hOrd, hOrder⟩ :=
    prefixCountedShuffleCutAtEntry hRange hFrame hCode hEntry hr he hBefore hReach hSafe
  refine ⟨t, index + front.length, stop, hOrder, ht, hRun, ?_⟩
  rw [hOrd, hRank]
  change rank + prior + _ = _
  rw [Nat.add_assoc, hCount]

/-- The actual V source pointer and K-generated byte mask at any pair broadcast. -/
theorem primingVPairOperandsInPrefix {p : Params} {l : Launch} {m : Mem0} {X : Execution}
    (hp : Pre p l m) (hX : Consistent l kernel Assumptions.all m X)
    {g batch head tile warp lane index rank read : Nat} {residual : Nat → Nat}
    (hw : 14 ≤ warpIndex l g) (hb : batch < p.batch) (hh : head < p.kvHeads)
    {s : TState} {ending : Option TState}
    (hs : At s 805 (primingVReloadWords 0 (primingVPairBases p batch head tile warp 0 lane) ++
      vPacketFrame p l batch tile warp lane residual))
    (hr : Run kernel Assumptions.all l g s ((X.tr g).drop index) ending)
    (hRank : ((X.tr g).take index).countP Execution.isShfl = rank)
    {a : Acc} {bytes : List (Option Byte)} (hFirst : X.get (g, read) = some ⟨804, .rd a bytes⟩)
    (hSaved : PrimingCellValue X g read 799 (sourceScratchAccess l g 1)
      (b64 (primingVPairBases p batch head tile warp 8 lane)).toBytes)
    (pair : Fin 16) {j : Nat} {e : Event} (he : X.get (g, j) = some e) (hBefore : index ≤ j)
    (hLater : vPacketShufflePc pair < e.pc ∨ (Execution.isShfl e = true ∧
      rank + 2 * pair.val ≤ ((X.tr g).take j).countP Execution.isShfl))
    (hSafe : ∀ f, e.kind ≠ .ub f) :
    let base := primingVPairBases p batch head tile warp pair lane
    let frame := if pair.val = 0 then vPacketFrame p l batch tile warp lane residual
      else vPacketCarry p l batch tile warp lane residual
    ∃ t pos stop, pos ≤ j ∧ At t (vPacketShufflePc pair)
      (primingVReloadWords (vPacketSlot pair) base ++ frame) ∧
      Run kernel Assumptions.all l g t ((X.tr g).drop pos) stop ∧
      ((X.tr g).take pos).countP Execution.isShfl = rank + 2 * pair.val := by
  by_cases hZero : pair = 0
  · subst pair
    exact ⟨s, index, ending, hBefore, hs, hr, hRank⟩
  have hPositive : 0 < pair.val := by
    by_contra! h
    exact hZero (Fin.ext (by omega))
  have hPC : 808 ≤ vPacketShufflePc pair := by
    fin_cases pair <;> first | exact (hZero rfl).elim | decide
  obtain ⟨u, pos, stop, hPos, hu, huRun, huRank⟩ :=
    primingVColumnFrameInPrefix hs hr hRank he hBefore
      (hLater.imp (fun h => hPC.trans h.le) (fun ⟨hMark, hCount⟩ => ⟨hMark, by omega⟩)) hSafe
  rw [ite_eq_right (show pair.val ≠ 0 by omega)]
  let F := vPacketCarry p l batch tile warp lane residual
  let base := primingVPairBases p batch head tile warp pair lane
  by_cases hLow : pair.val < 8
  · have hSlot : vPacketSlot pair = 0 := Fin.ext (Nat.div_eq_of_lt hLow)
    have hAddr : primingVPairBases p batch head tile warp 0 lane = base := by
      simp [base, primingVPairBases, Nat.div_eq_of_lt hLow]
    rw [hSlot]
    apply vPacketCutLater (0 : Fin 2) pair hPositive hSlot
      (F := primingVReloadWords 0 base ++ F) (hAddr ▸ hu) ?_ huRun huRank he hPos
      (hLater.imp_left Nat.le_of_lt) hSafe
    intro branch
    fin_cases pair <;> first | exact (hZero rfl).elim |
      (set_option maxRecDepth 100000 in kernel_rfl)
  have hSlots : pair.val / 8 = 1 := by have := pair.isLt; omega
  have hSlot : vPacketSlot pair = 1 := Fin.ext hSlots
  have hAddr : primingVPairBases p batch head tile warp 8 lane = base := by
    simp [base, primingVPairBases, hSlots]
  let row := primingLaneRow tile (32 * warp + lane) + 64
  have hPage := primingScratchPageBound hp (row := row) hb
  obtain ⟨hEq, hFit, _⟩ := sourceScratchPayload_live hp 1 hPage (Nat.mod_lt row (by decide)) hh
  have hBase : base < 2 ^ 64 := by
    rw [hEq] at hFit
    simpa [base, primingVPairBases, primingVRowPointer, hSlots, row] using hFit
  have hPC : 854 ≤ vPacketShufflePc pair := by
    fin_cases pair <;> first | exact (hLow (by decide)).elim | decide
  have hLater' : 854 < e.pc ∨ (Execution.isShfl e = true ∧
      rank + 2 + 14 ≤ ((X.tr g).take j).countP Execution.isShfl) :=
    hLater.imp (fun h => hPC.trans_lt h) (fun ⟨hMark, hCount⟩ => ⟨hMark, by omega⟩)
  obtain ⟨v, nextPos, stop', hNext, hv, hvRun, hvRank⟩ :=
    primingVSecondPointerInPrefix hp hX hw hBase (hu.mono hu.2.2.2.2.2.2)
      (by intro branch; set_option maxRecDepth 100000 in kernel_rfl)
      (by simp [vPacketCarry, vPacketFrame, primingVPacketFrame])
      (by
        intro x hx
        have ha : (F.map Prod.fst).all (fun r => decide (r ≠ 1945 ∧ r ≠ 1946)) = true := by
          set_option maxRecDepth 100000 in kernel_rfl
        exact of_decide_eq_true (List.all_eq_true.mp ha _ (List.mem_map_of_mem hx)))
      huRun huRank hFirst (hAddr ▸ hSaved) he hPos hLater' hSafe
  rw [hSlot]
  apply vPacketCutLater (1 : Fin 2) pair hPositive hSlot hv ?_ hvRun hvRank he hNext
    (hLater.imp_left Nat.le_of_lt) hSafe
  intro branch
  fin_cases pair <;> first | exact (hLow (by decide)).elim |
    (set_option maxRecDepth 100000 in kernel_rfl)

end
end PTX.Kernels.TmlFa4Fwd.Loader
