/-- The value of register `r` at state `d`: the role's tables, else the prologue's. -/
def valueOf (L : Launch) (g : Nat) (d : D) (r : Nat) : Value :=
  ((ctrlValues L g d ++ floatValues L d).lookup r).getD
    (Prologue.valueOf L g (warpOf L g) (rankOf L g) r)

/-- The registers live at `pc`, with their values in state `d`. -/
def factsAt (L : Launch) (g pc : Nat) (d : D) : List (Nat × Value) :=
  Flow.factsFrom (Flow.live pc) (valueOf L g d)

/-- The registers a load writes, live at its implicit wait beyond the code's liveness at its
`pc`. -/
def Site.extra : Site → List Nat
  | .ldW lp c => ldRegs lp c.val
  | _ => []

/-- The facts of a state. -/
abbrev facts (L : Launch) (g : Nat) (d : D) : List (Nat × Value) :=
  Flow.factsFrom (Flow.live d.site.pc ++ d.site.extra) (valueOf L g d)

