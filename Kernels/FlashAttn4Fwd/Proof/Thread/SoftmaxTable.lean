module

public import Kernels.FlashAttn4Fwd.Proof.Thread.SoftmaxReals
public import Kernels.FlashAttn4Fwd.Proof.Thread.Prologue

@[expose] public section

/-! # The registers of a softmax state

Every register live at a softmax site is a function of the state (`valueOf`): the floating
registers (`floatValues`: the words a load returned `d.w j`, their packs
`joinValue (d.w j) (d.w (j + 1))`, after the first tile's row maximum its selected halves (again
`d.w j`), and the values the code computes from them: the probabilities `p0V`/`p1V`, their
half-precision conversions and packs, the loop tile's new maximum `mNV`, rescale factor `alphaV`
and exponent maximum `mExpV`), the schedule registers (`ctrlValues`: the parities of the
statistics and score polls, the trip counter, the item register, the addresses), and the
prologue's registers for the thread's warp. The two loop-carried floating registers are the
reference maximum `%r3597 = d.m` and the row sum `%r3598 = d.l`. -/

namespace PTX.Kernels.FlashAttn4Fwd.Proof.Softmax
open PTX PTX.Proof PTX.Flow

noncomputable section
set_option maxRecDepth 100000

/-- The index of the statistics poll of the current trip: polls `(n + 1) i … (n + 1) i + n`
of item `i`; the register `%r3599` holds its parity offset by one (polls start at parity 1). -/
def statsIdx (L : Launch) (d : D) : Nat := (trips L + 1) * d.i + 1 + d.t

/-- The index of the score tile of the state: `n i` for the first tile of item `i` (and at the
tail, after the items), then one per loop trip (`%r3600` holds its parity). -/
def tileIdx (L : Launch) (d : D) : Nat :=
  trips L * d.i + if d.site.tile0 || d.site = .statsW 3 then 0 else d.t + 1

/-- The schedule registers and addresses. -/
def ctrlValues (L : Launch) (g : Nat) (d : D) : List (Nat × Value) :=
  let st := stOf L g
  [(404, b32 (trips L - 1)), (405, leadPtr L g (144 + 8 * st)),
   (406, leadPtr L g (160 + 8 * st)), (407, .bits 32 (Work.GW L)),
   (1006, Prologue.sb L (240 + 8 * st)), (1007, Prologue.sb L (128 + 8 * st)),
   (1017, b32 (kOf L g + 3 + 4 * st)),
   (1094, b32 (tmem L g 0)), (1095, b32 (tmem L g 96)), (1096, b32 (tmem L g 32)),
   (1097, b32 (tmem L g 64)), (1098, b32 (tmem L g 112)), (1099, b32 (tmem L g 80)),
   (1101, Prologue.sb L (8 * st)),
   (1955, b32 1), (1973, b32 1), (2668, b32 1), (2686, b32 1),
   (1974, Prologue.sb L (240 + 8 * st)), (1975, b32 ((statsIdx L d + 1) % 2)),
   (1980, Prologue.sb L (128 + 8 * st)),
   (2053, b32 (128 * st)), (2054, b32 (tidOf L g)),
   (2057, b32 (tmem L g 0)), (2058, b32 (tmem L g 96)), (2059, b32 (tmem L g 32)),
   (2060, b32 (tmem L g 64)), (2061, b32 (tmem L g 112)), (2062, b32 (tmem L g 80)),
   (2395, Prologue.sb L (4 * tidOf L g)), (2687, Prologue.sb L (240 + 8 * st)),
   (2699, Prologue.sb L (4 * tidOf L g)), (2700, Prologue.sb L (240 + 8 * st)),
   (3901, scaleV L), (3902, scaleV L), (4109, joinValue (scaleV L) (scaleV L)),
   (3930, .bits 32 (Work.workW L g d.i)), (3931, b32 d.t),
   (3932, d.m), (3933, d.l),
   (3934, b32 (statsIdx L d % 2)), (3935, b32 (tileIdx L d % 2)),
   (278, .pred (decide (trips L ≤ 1)))]

