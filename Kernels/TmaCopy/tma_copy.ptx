// SPDX-License-Identifier: Apache-2.0

// Hand-written minimal TMA kernel (checked by ptxas -arch=sm_100a): thread 0 copies 16 bytes
// from global A to shared memory with cp.async.bulk, waits on an mbarrier, then copies the
// first word to global B. The other threads exit.
.version 8.7
.target sm_100a
.address_size 64

	// .globl	tma_copy
.visible .entry tma_copy(
	.param .u64 tma_copy_param_0,
	.param .u64 tma_copy_param_1
)
{
	.reg .pred 	%p<3>;
	.reg .b32 	%r<10>;
	.reg .b64 	%rd<5>;
	.shared .align 16 .b8 buf[16];
	.shared .align 8 .b8 bar[8];

	mov.u32 	%r1, %tid.x;
	setp.ne.s32 	%p1, %r1, 0;
	@%p1 bra 	$L__BB0_3;
	ld.param.u64 	%rd1, [tma_copy_param_0];
	ld.param.u64 	%rd2, [tma_copy_param_1];
	cvta.to.global.u64 	%rd3, %rd1;
	cvta.to.global.u64 	%rd4, %rd2;
	mov.u32 	%r2, bar;
	mov.u32 	%r3, buf;
	mbarrier.init.shared::cta.b64 	[%r2], 1;
	fence.proxy.async.shared::cta;
	mbarrier.arrive.expect_tx.shared::cta.b64 	_, [%r2], 16;
	cp.async.bulk.shared::cta.global.mbarrier::complete_tx::bytes 	[%r3], [%rd3], 16, [%r2];
$L__BB0_2:
	mbarrier.try_wait.parity.shared::cta.b64 	%p2, [%r2], 0;
	@!%p2 bra 	$L__BB0_2;
	ld.shared.u32 	%r4, [%r3];
	st.global.u32 	[%rd4], %r4;
$L__BB0_3:
	ret;

}
