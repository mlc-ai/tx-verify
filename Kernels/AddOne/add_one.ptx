// Hand-written minimal kernel (checked by ptxas -arch=sm_100a): one CTA; thread i adds 1 to
// the 32-bit word A[i] in place.
.version 8.7
.target sm_100a
.address_size 64

	// .globl	add_one
.visible .entry add_one(
	.param .u64 add_one_param_0
)
{
	.reg .b32 	%r<4>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [add_one_param_0];
	cvta.to.global.u64 	%rd2, %rd1;
	mov.u32 	%r1, %tid.x;
	mul.wide.u32 	%rd3, %r1, 4;
	add.s64 	%rd2, %rd2, %rd3;
	ld.global.u32 	%r2, [%rd2];
	add.s32 	%r3, %r2, 1;
	st.global.u32 	[%rd2], %r3;
	ret;

}
