/-- **The machine stops following a thread (`some none`) in one case only**: at one of the
21 loads of the offsets array, on a read whose bytes rebuild to a value that is not a
64-bit integer. Everywhere else it follows the thread or says that it stops. This is the
hypothesis `Frame.tracked_of` asks about: the layer above shows that such a read returns
the launch's integer bytes (the assumption `inputReadOnly` and the precondition). -/
theorem next_giveUp (d : D) (e : Event) (h : next L g d e = some none) :
    ∃ j, d.site = .load j ∧ offsetLoads.contains j.val = true ∧
      ∃ a bs v, e.kind = .rd a bs ∧ rebuild 3 bs = .ok v ∧ ∀ y, v ≠ .bits 64 y := by
  obtain ⟨s, w, p, x⟩ := d
  cases s with
  | load j => exact ⟨j, rfl, next_load_giveUp L g w p x j e h⟩
  | elect j => exact absurd h (next_elect_ne L g w p x j e)
  | shfl j => exact absurd h (next_shfl_ne L g w p x j e)
  | mbarInit j => exact absurd h (next_mbarInit_ne L g w p x j e)
  | fenceMbarInit j => exact absurd h (next_fenceMbarInit_ne L g w p x j e)
  | bar j => exact absurd h (next_bar_ne L g w p x j e)
  | mbarArrive j => exact absurd h (next_mbarArrive_ne L g w p x j e)
  | tensorCopy j => exact absurd h (next_tensorCopy_ne L g w p x j e)
  | mbarWait j => exact absurd h (next_mbarWait_ne L g w p x j e)
  | fenceProxy j => exact absurd h (next_fenceProxy_ne L g w p x j e)
  | store j => exact absurd h (next_store_ne L g w p x j e)
  | trap j => exact absurd h (next_trap_ne L g w p x j e)
  | matrixLoad j => exact absurd h (next_matrixLoad_ne L g w p x j e)
  | warpMma j => exact absurd h (next_warpMma_ne L g w p x j e)
  | matrixMove j => exact absurd h (next_matrixMove_ne L g w p x j e)
  | matrixStore j => exact absurd h (next_matrixStore_ne L g w p x j e)
  | bulkCommit j => exact absurd h (next_bulkCommit_ne L g w p x j e)
  | bulkWait j => exact absurd h (next_bulkWait_ne L g w p x j e)
  | exit j => exact absurd h (next_exit_ne L g w p x j e)
  | matrixLoadMx j row => exact absurd h (next_matrixLoadMx_ne L g w p x j row e)
  | matrixStoreWr j row => exact absurd h (next_matrixStoreWr_ne L g w p x j row e)
  | loadEl1 j v0 => exact absurd h (next_loadEl1_ne L g w p x j v0 e)
  | loadEl2 j v0 v1 => exact absurd h (next_loadEl2_ne L g w p x j v0 v1 e)
  | loadEl3 j v0 v1 v2 => exact absurd h (next_loadEl3_ne L g w p x j v0 v1 v2 e)

end

