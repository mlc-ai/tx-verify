    next L g ⟨.elect j, w, p, x⟩ e ≠ some none := by
  obtain ⟨k, hk⟩ := j
  rcases Nat.lt_or_ge k 2 with h2 | h2
  · rcases Nat.lt_or_ge k 1 with h1 | h1
    · have hke : k = 0 := by omega
      subst hke
      rw [show next L g ⟨.elect ⟨0, hk⟩, w, p, x⟩ e = _ from
        next_elect_0 w p x e]
      ne_leaf
    · have hke : k = 1 := by omega
      subst hke
      rw [show next L g ⟨.elect ⟨1, hk⟩, w, p, x⟩ e = _ from
        next_elect_1 w p x e]
