/-- **The step obligation of every state**, under the launch facts (`Launched`, which
`Start.lean` proves from the specification's precondition). -/
theorem stepAt (hL : Launched L) (d : D) : (codeFrom L g d0).StepAt d := by
  obtain ⟨s, w, p, x⟩ := d
  cases s with
  | elect j => exact stepAt_elect w p x hL j
  | shfl j => exact stepAt_shfl w p x hL j
  | mbarInit j => exact stepAt_mbarInit w p x hL j
  | fenceMbarInit j => exact stepAt_fenceMbarInit w p x hL j
  | bar j => exact stepAt_bar w p x hL j
  | load j => exact stepAt_load w p x hL j
  | mbarArrive j => exact stepAt_mbarArrive w p x hL j
  | tensorCopy j => exact stepAt_tensorCopy w p x hL j
  | mbarWait j => exact stepAt_mbarWait w p x hL j
  | fenceProxy j => exact stepAt_fenceProxy w p x hL j
  | store j => exact stepAt_store w p x hL j
  | trap j => exact stepAt_trap w p x hL j
  | matrixLoad j => exact stepAt_matrixLoad w p x hL j
  | warpMma j => exact stepAt_warpMma w p x hL j
  | matrixMove j => exact stepAt_matrixMove w p x hL j
  | matrixStore j => exact stepAt_matrixStore w p x hL j
  | bulkCommit j => exact stepAt_bulkCommit w p x hL j
  | bulkWait j => exact stepAt_bulkWait w p x hL j
  | exit j => exact stepAt_exit w p x hL j
  | matrixLoadMx j row => exact stepAt_matrixLoadMx w p x hL j row
  | matrixStoreWr j row => exact stepAt_matrixStoreWr w p x hL j row
  | loadEl1 j v0 => exact stepAt_loadEl1 w p x hL j v0
  | loadEl2 j v0 v1 => exact stepAt_loadEl2 w p x hL j v0 v1
  | loadEl3 j v0 v1 v2 => exact stepAt_loadEl3 w p x hL j v0 v1 v2

end

