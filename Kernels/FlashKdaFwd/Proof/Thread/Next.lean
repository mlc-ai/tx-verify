/-- The successor after event `e`. -/
def next (L : Launch) (g : Nat) (d : D) (e : Event) : Option (Option D) :=
  match d.site with
  | .elect j => next_elect L g j d e
  | .shfl j => next_shfl L g j d e
  | .mbarInit j => next_mbarInit L g j d e
  | .fenceMbarInit j => next_fenceMbarInit L g j d e
  | .bar j => next_bar L g j d e
  | .load j => next_load L g j d e
  | .mbarArrive j => next_mbarArrive L g j d e
  | .tensorCopy j => next_tensorCopy L g j d e
  | .mbarWait j => next_mbarWait L g j d e
  | .fenceProxy j => next_fenceProxy L g j d e
  | .store j => next_store L g j d e
  | .trap j => next_trap L g j d e
  | .matrixLoad j => next_matrixLoad L g j d e
  | .warpMma j => next_warpMma L g j d e
  | .matrixMove j => next_matrixMove L g j d e
  | .matrixStore j => next_matrixStore L g j d e
  | .bulkCommit j => next_bulkCommit L g j d e
  | .bulkWait j => next_bulkWait L g j d e
  | .exit j => next_exit L g j d e
  | .matrixLoadMx j row => next_matrixLoadMx L g j row d e
  | .matrixStoreWr j row => next_matrixStoreWr L g j row d e
  | .loadEl1 j v0 => next_loadEl1 L g j v0 d e
  | .loadEl2 j v0 v1 => next_loadEl2 L g j v0 v1 d e
  | .loadEl3 j v0 v1 v2 => next_loadEl3 L g j v0 v1 v2 d e

