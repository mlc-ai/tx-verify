/-- The positions of the matrix event of an `stmatrix` (its first event). -/
def stPos : List Nat :=
  [164, 166, 180, 182, 192, 194, 204, 206, 216, 218, 228, 230, 240, 242, 252, 254, 260, 262]

theorem st_pos : ∀ n < 268, isWr (skOf (n + 1)) = true → n ∈ stPos := by decide +kernel

/-- The state behind the matrix event of an `stmatrix`, when it is a state: at the second
site of the instruction, with the 16 bytes received, all known. -/
theorem stRecv_row {d d' : D} {recv : List (Option Byte)} {s : List (Option Byte) → Site}
    (h : stRecv d recv s = some (some d')) :
    d'.site = s recv ∧ recv.length = 16 ∧ recv.all Option.isSome = true := by
  unfold stRecv at h
  split at h
  · rename_i hc
    obtain rfl := Option.some.inj (Option.some.inj h)
    exact ⟨rfl, hc.1, hc.2⟩
  · cases h

/-- **The row of an `stmatrix` write**: the successor of the matrix event of an `stmatrix`
(position `n`, the row write being position `n + 1`) is at the row-write site of the
instruction and carries 16 known bytes. -/
theorem st_row {n : Nat} {site : Site} {s' : D} (hn : n < 268)
    (hw : isWr (skOf (n + 1)) = true) (hs : (skOf n).At site)
    (hnext : Thread.next L g ⟨site, w, p, x⟩ e = some (some s')) :
    ∃ j row, s'.site = .matrixStoreWr j row ∧ row.length = 16 ∧
      row.all Option.isSome = true := by
  have hmem := st_pos n hn hw
  simp only [stPos, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
    rfl | rfl | rfl | rfl | rfl
  · obtain rfl : site = .matrixStore 0 := hs
    rw [next_matrixStore_0] at hnext
    obtain ⟨op, own, recv, -, hf⟩ := stNext_some hnext
    obtain ⟨h1, h2, h3⟩ := stRecv_row hf
    exact ⟨_, recv, h1, h2, h3⟩
  · obtain rfl : site = .matrixStore 1 := hs
    rw [next_matrixStore_1] at hnext
    obtain ⟨op, own, recv, -, hf⟩ := stNext_some hnext
    obtain ⟨h1, h2, h3⟩ := stRecv_row hf
    exact ⟨_, recv, h1, h2, h3⟩
  · obtain rfl : site = .matrixStore 2 := hs
    rw [next_matrixStore_2] at hnext
    obtain ⟨op, own, recv, -, hf⟩ := stNext_some hnext
    obtain ⟨h1, h2, h3⟩ := stRecv_row hf
    exact ⟨_, recv, h1, h2, h3⟩
  · obtain rfl : site = .matrixStore 3 := hs
    rw [next_matrixStore_3] at hnext
    obtain ⟨op, own, recv, -, hf⟩ := stNext_some hnext
