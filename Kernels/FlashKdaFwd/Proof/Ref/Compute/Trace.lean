/-! ### The phase theorem -/

variable (P L X g) in
/-- **The Compute phase**, in the form of `Ref/Chain.lean`. -/
def phase : Phase (code L) g where
  In := In P L X g
  Inv := Inv P L X g
  Out := Out P L X g

/-- The ledger of one more event. -/
theorem ledOf_succ {k : Nat} (he : X.get (g, k) = some e) :
    ledOf L (g / L.block) ((X.tr g).take (k + 1)) =
      ledOf L (g / L.block) ((X.tr g).take k) + ledEv L (g / L.block) e := by
  simp only [ledOf, ledEv, Led.add_def, okPolls, arrivals, count_snoc _ he]

/-- The counted events since the entry, with one more event. -/
theorem counted_succ {j0 k : Nat} (hjk : j0 ≤ k) (he : X.get (g, k) = some e) :
    counted X g j0 (k + 1) = counted X g j0 k + (if e.counts = true then 1 else 0) := by
  have hg : (X.tr g)[k]? = some e := he
  have hk : k < (X.tr g).length := (List.getElem?_eq_some_iff.mp hg).1
  unfold counted
  rw [List.take_add_one, hg, Option.toList_some,
    List.drop_append_of_le_length (by rw [List.length_take]; omega), List.countP_append,
    List.countP_singleton]

/-- No event is counted between the entry and itself. -/
theorem counted_self (j0 : Nat) : counted X g j0 j0 = 0 := by
  unfold counted
  rw [List.drop_eq_nil_of_le (by rw [List.length_take]; omega)]
  rfl

/-- The entry condition is the invariant at the entry. -/
theorem inv_entry {j0 : Nat} {s0 : D} (hin : In P L X g j0 s0) : Inv P L X g j0 j0 s0 :=
  ⟨.entry, ⟨hin.1.site, hin.1⟩, hin.2, le_rfl, counted_self j0⟩

/-- **The invariant of the Compute phase along a thread's states**, the pending state included:
from the entry condition at a followed state `k0`, every followed state at a later position `k`
(up to the length of the thread's trace) satisfies the invariant, or the exit condition held at
a followed state between the two. -/
theorem inv_at (hpre : Pre P L mem0) (hX : Consistent L kernel Assumptions.all mem0 X)
    (hg : g < L.threads) {k0 k : Nat} {s0 s : D} (h0 : At (code L) X g k0 s0)
    (hin : In P L X g k0 s0) (hk0 : k0 ≤ k) (hk : k ≤ (X.tr g).length)
    (hs : At (code L) X g k s) :
    Inv P L X g k0 k s ∨
      ∃ j s1, k0 ≤ j ∧ j ≤ k ∧ At (code L) X g j s1 ∧ Out P L X g k0 j s1 := by
  have hC : ∀ g < L.threads, (code L g).Sound := fun _ h => Thread.sound hpre h
  have key := Frame.stateAt_inv (C := code L) (X := X) (g := g)
    (fun k s => k0 ≤ k →
      Inv P L X g k0 k s ∨ ∃ j s1, k0 ≤ j ∧ j ≤ k ∧ At (code L) X g j s1 ∧ Out P L X g k0 j s1)
    (fun h00 => by
      obtain rfl : k0 = 0 := by omega
      have e0 : s0 = (code L g).init :=
        Option.some.inj (Option.some.inj (h0.symm.trans Frame.stateAt_zero))
      have hi := inv_entry hin
      rw [e0] at hi
      exact .inl hi) (by
      intro k e s s' he hσ hI hn hk1
      have hσ' : Frame.stateAt (code L) X g (k + 1) = some (some s') := by
        rw [Frame.stateAt_succ he, hσ]
        exact hn
      rcases Nat.eq_or_lt_of_le hk1 with heq | hlt
      · subst heq
        have e0 : s0 = s' := Option.some.inj (Option.some.inj (h0.symm.trans hσ'))
        have hi := inv_entry hin
        rw [e0] at hi
        exact .inl hi
      · rcases hI (by omega) with ⟨pos, hR, hled, hjk, hcnt⟩ | ⟨j, s1, h1, h2, h3, h4⟩
        · obtain ⟨tt, ins, o, hat, -, hc, hf⟩ := Frame.fired_site hC hX he hσ
          rcases good hpre hg hR hat hc hf hn with ⟨pos', hR', hl, hi⟩ | ⟨hx, hl, hi⟩
          · exact .inl ⟨pos', hR', by rw [ledOf_succ he, hled, hl], by omega,
              by rw [counted_succ hjk he, hcnt, hi]⟩
          · exact .inr ⟨k + 1, s', by omega, le_rfl, hσ', hx, by rw [ledOf_succ he, hled, hl],
              by omega, by rw [counted_succ hjk he, hcnt, hi]⟩
        · exact .inr ⟨j, s1, h1, by omega, h3, h4⟩)
  exact key k s hk hs hk0

/-- **The theorem of the Compute phase**, in the form of `Ref/Chain.lean`. -/
theorem traces (hpre : Pre P L mem0) (hX : Consistent L kernel Assumptions.all mem0 X)
    (hg : g < L.threads) : (phase P L X g).Traces X :=
  fun _ _ _ _ h0 hin hk0 hk hs => inv_at hpre hX hg h0 hin hk0 hk.le hs

end

