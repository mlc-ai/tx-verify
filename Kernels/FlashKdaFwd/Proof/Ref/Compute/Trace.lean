/-! ### The case analysis -/

/-- **The step of the invariant**: the event at a state of a position, when the successor is a
state, leads to a position or to the exit. -/
theorem good (hpre : Pre P L mem0) (hg : g < L.threads) {pos : Pos} {s : D}
    (h : RefAt P L g pos s) (hat : (code L g).AtD s tt)
    (hc : kernel.code[s.site.pc]? = some ins)
    (hf : Fires s.site.pc (eventTmpl Assumptions.all L g tt ins.op) e o)
    (hn : Thread.next L g s e = some (some s')) : Next P L g pos e s' := by
  obtain ⟨site, w, p, x⟩ := s
  cases pos with
  | entry =>
    obtain rfl : site = .bar 5 := h.site
    exact good_entry hpre hg h.facts hc hf hn
  | tile t n =>
    have hn268 : n < 268 := h.facts.pos
    rcases Nat.lt_or_ge n 134 with hm | hm
    ·
      rcases Nat.lt_or_ge n 67 with hm | hm
      ·
        rcases Nat.lt_or_ge n 33 with hm | hm
        ·
          rcases Nat.lt_or_ge n 16 with hm | hm
          ·
            rcases Nat.lt_or_ge n 8 with hm | hm
            ·
              rcases Nat.lt_or_ge n 4 with hm | hm
              ·
                rcases Nat.lt_or_ge n 2 with hm | hm
                ·
                  rcases Nat.lt_or_ge n 1 with hm | hm
                  ·
                    obtain rfl : n = 0 := by omega
                    obtain rfl : site = .mbarWait 7 := h.site
                    exact good_0 hpre h.facts hat hc hf hn
                  ·
                    obtain rfl : n = 1 := by omega
                    obtain rfl : site = .mbarWait 8 := h.site
                    exact good_1 hpre h.facts hat hc hf hn
                ·
                  rcases Nat.lt_or_ge n 3 with hm | hm
                  ·
                    obtain rfl : n = 2 := by omega
                    obtain rfl : site = .matrixLoad 0 := h.site
                    exact good_2 h.facts hn
                  ·
                    obtain rfl : n = 3 := by omega
                    obtain ⟨row, rfl⟩ : ∃ row, site = .matrixLoadMx 0 row := h.site
                    exact good_3 hpre h.facts hn
              ·
                rcases Nat.lt_or_ge n 6 with hm | hm
                ·
                  rcases Nat.lt_or_ge n 5 with hm | hm
                  ·
                    obtain rfl : n = 4 := by omega
                    obtain rfl : site = .matrixLoad 1 := h.site
                    exact good_4 h.facts hn
                  ·
                    obtain rfl : n = 5 := by omega
                    obtain ⟨row, rfl⟩ : ∃ row, site = .matrixLoadMx 1 row := h.site
                    exact good_5 h.facts hn
                ·
                  rcases Nat.lt_or_ge n 7 with hm | hm
                  ·
                    obtain rfl : n = 6 := by omega
                    obtain rfl : site = .matrixLoad 2 := h.site
                    exact good_6 h.facts hn
                  ·
                    obtain rfl : n = 7 := by omega
                    obtain ⟨row, rfl⟩ : ∃ row, site = .matrixLoadMx 2 row := h.site
                    exact good_7 h.facts hn
            ·
              rcases Nat.lt_or_ge n 12 with hm | hm
              ·
                rcases Nat.lt_or_ge n 10 with hm | hm
                ·
                  rcases Nat.lt_or_ge n 9 with hm | hm
                  ·
                    obtain rfl : n = 8 := by omega
                    obtain rfl : site = .matrixLoad 3 := h.site
                    exact good_8 h.facts hn
                  ·
                    obtain rfl : n = 9 := by omega
                    obtain ⟨row, rfl⟩ : ∃ row, site = .matrixLoadMx 3 row := h.site
                    exact good_9 h.facts hn
                ·
                  rcases Nat.lt_or_ge n 11 with hm | hm
                  ·
                    obtain rfl : n = 10 := by omega
                    obtain rfl : site = .warpMma 0 := h.site
                    exact good_10 h.facts hn
                  ·
                    obtain rfl : n = 11 := by omega
                    obtain rfl : site = .warpMma 1 := h.site
                    exact good_11 h.facts hn
              ·
                rcases Nat.lt_or_ge n 14 with hm | hm
                ·
                  rcases Nat.lt_or_ge n 13 with hm | hm
                  ·
                    obtain rfl : n = 12 := by omega
                    obtain rfl : site = .warpMma 2 := h.site
                    exact good_12 h.facts hn
                  ·
                    obtain rfl : n = 13 := by omega
                    obtain rfl : site = .warpMma 3 := h.site
                    exact good_13 hpre h.facts hn
                ·
