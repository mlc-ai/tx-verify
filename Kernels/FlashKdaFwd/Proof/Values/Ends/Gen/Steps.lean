theorem final_0 {d d' : D} {e : Event} (hs : d.site = .store 18)
    (hn : Thread.next L g d e = some (some d')) :
    d'.site = .store 19 ∧ ∀ r < 2246, d'.x r = d.x r := by
  obtain ⟨s, w, p, x⟩ := d
  cases hs
  rw [next_store_18] at hn
  obtain ⟨-, rfl⟩ := across_eq_some hn
  exact ⟨rfl, fun r hr => valueEx_ne (by omega) _ _⟩

theorem finalWr_0 (F : Followed L mem0 X) {k pc : ℕ} {a : Acc} {bs : List Byte} {d : D}
    (he : X.get (g, k) = some ⟨pc, .wr a bs⟩) (hσ : stateAt (code L) X g k = some (some d))
    (hs : d.site = .store 18) : ∃ v', storeValue 32 (d.x 2213) = .ok v' ∧ bs = v'.toBytes :=
  store_bytes_generic F he hσ (by rw [hs]; exact Flow.code_3132) rfl (fun _ => rfl) rfl rfl rfl
    (by rw [hs]; rfl) (by rw [hs]; kernel_rfl) rfl

