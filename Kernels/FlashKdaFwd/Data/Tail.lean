private def branch (p target : Nat) : Instr := ⟨some (p,false), .bra target false⟩

private def zero (r : Nat) (off : Int) : Instr :=
  ⟨none, .mem {
    kind := .store, space := some (.shared .cta), sem := .weak, elem := .int .b 16,
    addr := ⟨.reg r 32,off⟩, srcs := [.imm 0] }⟩

private def unary (op : IntOp) (ty : DType) (d : Nat) (a : Opnd) : Instr :=
  ⟨none, .int ⟨op, ty, false, [some d], [a]⟩⟩

